<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Casa Amaral</title>
<meta name="description" content="Casa Amaral — materiais para construção, hidráulica, elétrica, ferramentas, tintas e acabamento.">
<script>
(() => {
  const saved = localStorage.getItem('casa-amaral-theme');
  const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme:dark)').matches;
  document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
})();
</script>
<style>
:root{
  color-scheme:light;
  --bg:#f7f8fa;--surface:#fff;--surface2:#f3f5f7;--surface3:#e9eef2;
  --text:#11161c;--heading:#0c1117;--muted:#64707c;--subtle:#87929d;--line:#dfe5ea;
  --accent:#f2b300;--accent2:#ffd761;--primary:#111820;--primaryfg:#fff;
  --tag:#fff;--tagfg:#111820;--header:rgba(247,248,250,.9);
  --wa:#20b85a;--wa2:#159a49;--shadow:0 16px 44px rgba(15,23,32,.08);--danger:#d94b4b;
}
html[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0b1015;--surface:#111820;--surface2:#151d25;--surface3:#1d2731;
  --text:#f4f7f9;--heading:#fff;--muted:#c1c9d0;--subtle:#97a3ae;--line:#2a3641;
  --accent:#ffc21c;--accent2:#ffe184;--primary:#f4f7f9;--primaryfg:#0b1015;
  --tag:#1a2530;--tagfg:#f4f7f9;--header:rgba(11,16,21,.9);
  --wa:#25d366;--wa2:#1fb75a;--shadow:0 18px 54px rgba(0,0,0,.28);--danger:#ff6b6b;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:"Segoe UI Variable","Aptos","Inter",system-ui,-apple-system,sans-serif;
  color:var(--text);background:radial-gradient(circle at 86% 4%,color-mix(in srgb,var(--accent) 8%,transparent),transparent 24rem),var(--bg);
  transition:background .3s,color .3s;overflow-x:hidden
}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit}
button{cursor:pointer}
.shell{width:min(1240px,calc(100% - 32px));margin:auto}
.view{display:none}
.view.active{display:block}

header{
  position:sticky;top:0;z-index:50;background:var(--header);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)
}
.nav{height:78px;display:flex;align-items:center;gap:28px}
.brand{display:flex;align-items:center;gap:12px;font-weight:950;letter-spacing:-.04em;white-space:nowrap}
.brand-mark{width:42px;height:42px;border-radius:14px;background:var(--primary);position:relative}
.brand-mark:before{content:"";position:absolute;left:10px;top:12px;width:22px;height:17px;background:var(--accent);clip-path:polygon(50% 0,100% 36%,100% 100%,0 100%,0 36%)}
.brand-mark:after{content:"";position:absolute;left:18px;top:21px;width:6px;height:9px;background:var(--primaryfg)}
.menu{display:flex;gap:24px;flex:1}
.menu button{border:0;background:transparent;color:var(--muted);font-size:.94rem;padding:8px 0}
.menu button:hover,.menu button.active{color:var(--text)}
.menu button.active{font-weight:850}
.nav-actions{display:flex;gap:9px}
.icon-btn,.cart-btn{
  min-height:44px;border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:14px;
  display:inline-flex;align-items:center;justify-content:center;font-weight:800
}
.icon-btn{width:44px}
.cart-btn{padding:0 16px;gap:9px}
.count{min-width:21px;height:21px;border-radius:999px;background:var(--accent);color:#111820;display:grid;place-items:center;font-size:.72rem}
.mobile-menu{display:none}

.preloader{
  position:fixed;inset:0;z-index:999;background:var(--bg);display:grid;place-items:center;transition:.45s
}
.preloader.hide{opacity:0;visibility:hidden}
.loadbox{text-align:center}
.gear{width:70px;height:70px;margin:auto;border:12px solid var(--accent);border-radius:50%;position:relative;animation:spin 1.5s linear infinite}
.gear:after{content:"";position:absolute;inset:12px;background:var(--bg);border-radius:50%}
.loadbox h3{margin:18px 0 5px;color:var(--heading)}
.loadbox p{margin:0;color:var(--muted);font-size:.86rem}
@keyframes spin{to{transform:rotate(360deg)}}

.home-hero{
  min-height:calc(100svh - 78px);display:grid;grid-template-columns:1.02fr .98fr;gap:38px;align-items:center;padding:34px 0
}
.eyebrow{display:flex;align-items:center;gap:10px;color:var(--subtle);font-size:.78rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.eyebrow:before{content:"";width:34px;height:2px;background:var(--accent)}
.home-copy h1{margin:18px 0;font-size:clamp(4rem,7vw,7rem);line-height:.86;letter-spacing:-.075em;color:var(--heading);max-width:710px}
.home-copy h1 span{color:var(--accent)}
.home-copy p{max-width:610px;color:var(--muted);font-size:1.08rem;line-height:1.68}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.cta{min-height:54px;padding:0 22px;border-radius:14px;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--line)}
.cta.primary{background:var(--primary);color:var(--primaryfg);border-color:transparent}
.cta.primary:hover{background:var(--accent);color:#111820}
.cta.secondary{background:var(--surface);color:var(--text)}
.stage{
  height:610px;position:relative;border:1px solid var(--line);border-radius:32px;overflow:hidden;
  background:linear-gradient(145deg,var(--surface),var(--surface2));box-shadow:var(--shadow)
}
.orb{position:absolute;border-radius:50%;filter:blur(4px)}
.orb.a{width:230px;height:230px;right:0;top:0;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 22%,transparent),transparent 70%)}
.orb.b{width:190px;height:190px;left:0;bottom:0;background:radial-gradient(circle,color-mix(in srgb,#557eaa 10%,transparent),transparent 70%)}
.sprite-frame{position:absolute;inset:0;display:grid;place-items:center;padding-bottom:52px}
.sprite{
  width:min(94%,560px);aspect-ratio:1/1;background-image:url("data:image/png;base64,");
  background-size:200% 200%;background-repeat:no-repeat;animation:frames 1.35s steps(1) infinite,float 3.4s ease-in-out infinite;
  filter:drop-shadow(0 16px 20px rgba(0,0,0,.15))
}
@keyframes frames{
  0%,24.99%{background-position:0 0}
  25%,49.99%{background-position:100% 0}
  50%,74.99%{background-position:0 100%}
  75%,100%{background-position:100% 100%}
}
@keyframes float{50%{transform:translateY(-7px)}}
.wa-card{
  position:absolute;left:6%;right:6%;bottom:5%;z-index:4;display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:13px 15px;border-radius:17px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(14px)
}
.wa-id{display:flex;align-items:center;gap:11px}
.wa-icon{width:42px;height:42px;border-radius:13px;background:var(--wa);color:#07120b;display:grid;place-items:center;font-weight:950}
.wa-text strong{display:block;color:var(--heading);font-size:.94rem}
.wa-text span{display:block;color:var(--muted);font-size:.8rem;margin-top:2px}
.wa-button{min-height:42px;padding:0 14px;border:0;border-radius:12px;background:var(--wa);color:#07120b;font-weight:900}
.wa-button:hover{background:var(--wa2)}

.catalog-hero{padding:56px 0 28px}
.crumbs{display:flex;gap:8px;align-items:center;color:var(--subtle);font-size:.84rem;margin-bottom:18px}
.catalog-row{display:flex;justify-content:space-between;align-items:end;gap:30px}
.catalog-hero h1{margin:0;font-size:clamp(3rem,6vw,5.6rem);line-height:.92;letter-spacing:-.065em;color:var(--heading)}
.catalog-hero p{max-width:620px;color:var(--muted);line-height:1.65;margin:15px 0 0}
.stats{text-align:right;color:var(--muted);font-size:.85rem}
.stats strong{display:block;color:var(--heading);font-size:1.55rem}

.toolbar-wrap{position:sticky;top:78px;z-index:30;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(14px);padding:12px 0 14px}
.toolbar{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:12px;display:grid;grid-template-columns:minmax(230px,1fr) auto auto;gap:10px;box-shadow:var(--shadow)}
.search{position:relative}
.search span{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--subtle)}
.search input{width:100%;height:48px;border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:14px;padding:0 16px 0 44px;outline:none}
.search input:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 14%,transparent)}
.select{height:48px;border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:14px;padding:0 38px 0 14px}
.filter-toggle{display:none;height:48px;border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:14px;padding:0 14px;font-weight:850}
.content{display:grid;grid-template-columns:220px 1fr;gap:24px;padding:22px 0 90px}
.sidebar{position:sticky;top:158px;align-self:start}
.sidebar h3{margin:0 0 14px;font-size:.95rem}
.filters{display:flex;flex-direction:column;gap:7px}
.filter{width:100%;border:0;background:transparent;color:var(--muted);border-radius:12px;padding:10px 12px;text-align:left;display:flex;justify-content:space-between;align-items:center}
.filter:hover{background:var(--surface);color:var(--text)}
.filter.active{background:var(--surface);color:var(--text);font-weight:850;box-shadow:inset 3px 0 0 var(--accent)}
.filter small{color:var(--subtle)}
.results-head{display:flex;justify-content:space-between;gap:14px;margin-bottom:14px;color:var(--muted);font-size:.86rem}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.product{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:13px;transition:.2s}
.product:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.media{min-height:210px;border-radius:16px;background:linear-gradient(145deg,var(--surface2),var(--surface3));display:grid;place-items:center;overflow:hidden}
.media .emoji{font-size:5rem;filter:drop-shadow(0 12px 15px rgba(0,0,0,.12));transition:.25s}
.product:hover .emoji{transform:scale(1.06) rotate(-2deg)}
.tag{position:absolute;left:22px;top:22px;background:var(--tag);color:var(--tagfg);border:1px solid var(--line);border-radius:999px;padding:6px 9px;font-size:.69rem;font-weight:900}
.cat{margin-top:13px;color:var(--subtle);font-size:.73rem;text-transform:uppercase;letter-spacing:.08em;font-weight:850}
.product h3{margin:6px 0 5px;font-size:1rem;line-height:1.35;color:var(--heading)}
.desc{font-size:.79rem;color:var(--muted);line-height:1.45;min-height:35px}
.price-row{display:flex;justify-content:space-between;align-items:end;gap:10px;margin-top:15px}
.old{display:block;color:var(--subtle);font-size:.75rem;text-decoration:line-through;min-height:16px}
.price{font-size:1.2rem;font-weight:900;color:var(--heading)}
.add{border:0;background:var(--primary);color:var(--primaryfg);border-radius:13px;padding:11px 13px;font-weight:850}
.add:hover{background:var(--accent);color:#111820}
.empty{display:none;text-align:center;padding:70px 20px;background:var(--surface);border:1px dashed var(--line);border-radius:20px;color:var(--muted)}

.drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:70;opacity:0;visibility:hidden;transition:.25s}
.drawer{position:fixed;right:0;top:0;bottom:0;width:min(430px,94vw);background:var(--surface);z-index:80;transform:translateX(105%);transition:.3s;display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.16)}
.drawer.open{transform:none}.drawer-backdrop.open{opacity:1;visibility:visible}
.drawer-head{height:78px;padding:0 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.drawer-head h2{font-size:1.15rem;margin:0}
.close{width:40px;height:40px;border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:12px}
.cart-list{padding:14px 18px;overflow:auto;flex:1}
.cart-empty{color:var(--muted);text-align:center;padding:70px 20px}
.cart-item{display:grid;grid-template-columns:48px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.cart-thumb{width:48px;height:48px;border-radius:12px;background:var(--surface2);display:grid;place-items:center;font-size:1.7rem}
.cart-info strong{display:block;font-size:.88rem}.cart-info span{display:block;color:var(--muted);font-size:.77rem;margin-top:3px}
.qty{display:flex;align-items:center;gap:6px;margin-top:7px}
.qty button{width:26px;height:26px;border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:8px}
.remove{border:0;background:transparent;color:var(--danger);font-size:.78rem}
.drawer-foot{padding:18px;border-top:1px solid var(--line)}
.total{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.total span{color:var(--muted)}.total strong{font-size:1.25rem}
.checkout{width:100%;height:50px;border:0;border-radius:14px;background:var(--wa);color:#07120b;font-weight:900}
.checkout:disabled{opacity:.45;cursor:not-allowed}
.float-wa{position:fixed;right:20px;bottom:20px;width:54px;height:54px;border-radius:50%;background:var(--wa);display:grid;place-items:center;color:#06120a;font-size:1.5rem;z-index:35;box-shadow:0 12px 30px color-mix(in srgb,var(--wa) 30%,transparent)}

@media(max-width:1020px){
  .menu{display:none}.mobile-menu{display:inline-flex}
  .home-hero{grid-template-columns:1fr;text-align:center;padding-top:38px}
  .eyebrow{justify-content:center}.home-copy p{margin-inline:auto}.hero-actions{justify-content:center}
  .content{grid-template-columns:1fr}.sidebar{display:none;position:static}.sidebar.open{display:block}
  .filter-toggle{display:block}.products{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:650px){
  .shell{width:min(100% - 20px,1240px)}.nav{height:66px;gap:8px}.brand span{font-size:.9rem}
  .cart-btn{padding:0 10px;font-size:.8rem}.home-hero{min-height:auto;padding:26px 0 34px}
  .home-copy h1{font-size:clamp(3.2rem,16vw,5rem)}.stage{height:430px}
  .sprite-frame{padding-bottom:72px}.sprite{width:min(96%,390px)}
  .wa-card{left:4%;right:4%;bottom:3%;padding:10px 11px;gap:8px}
  .wa-text strong{font-size:.86rem}.wa-text span{font-size:.7rem}.wa-button{font-size:.76rem;padding:0 10px}
  .toolbar-wrap{top:66px}.toolbar{grid-template-columns:1fr auto;padding:9px}.toolbar .select{grid-column:1/-1}
  .catalog-row{display:block}.stats{text-align:left;margin-top:18px}
  .products{grid-template-columns:1fr 1fr;gap:10px}.product{padding:9px;border-radius:18px}.media{min-height:150px}.media .emoji{font-size:3.6rem}
  .desc{display:none}.product h3{font-size:.88rem}.price{font-size:1rem}.add{padding:9px 10px;font-size:.75rem}
}
@media(max-width:430px){.products{grid-template-columns:1fr}.media{min-height:190px}}
</style>
</head>
<body>
<div class="preloader" id="preloader"><div class="loadbox"><div class="gear"></div><h3>Preparando sua obra</h3><p>Carregando a Casa Amaral...</p></div></div>

<header>
  <div class="shell nav">
    <button class="icon-btn mobile-menu" id="mobileHome" aria-label="Início">☰</button>
    <button class="brand" id="brandBtn" style="border:0;background:transparent;color:inherit;padding:0"><span class="brand-mark"></span><span>CASA AMARAL</span></button>
    <nav class="menu">
      <button data-nav="categorias">Categorias</button>
      <button data-nav="ferramentas">Ferramentas</button>
      <button data-nav="produtos">Produtos</button>
      <button data-nav="contato">Contato</button>
    </nav>
    <div class="nav-actions">
      <button class="icon-btn" id="themeBtn" aria-label="Alternar tema">☾</button>
      <button class="icon-btn" id="searchBtn" aria-label="Buscar">⌕</button>
      <button class="cart-btn" id="cartBtn">Carrinho <span class="count" id="cartCount">0</span></button>
    </div>
  </div>
</header>

<main>
  <section class="view active" id="homeView">
    <div class="shell home-hero">
      <div class="home-copy">
        <div class="eyebrow">Casa de materiais de construção</div>
        <h1>Do básico <span>ao acabamento.</span></h1>
        <p>Materiais para construção, hidráulica, elétrica, ferramentas, tintas e acabamento. Tudo para sua obra, em um só lugar.</p>
        <div class="hero-actions">
          <button class="cta primary" id="heroProducts">Ver produtos <span>↗</span></button>
          <button class="cta secondary" id="heroCategories">Explorar categorias</button>
        </div>
      </div>
      <div class="stage">
        <div class="orb a"></div><div class="orb b"></div>
        <div class="sprite-frame"><div class="sprite"></div></div>
        <div class="wa-card">
          <div class="wa-id"><div class="wa-icon">◉</div><div class="wa-text"><strong>WhatsApp Casa Amaral</strong><span>(14) 3652-2025</span></div></div>
          <button class="wa-button" id="homeWhatsApp">Falar agora</button>
        </div>
      </div>
    </div>
  </section>

  <section class="view" id="productsView">
    <div class="shell catalog-hero">
      <div class="crumbs"><button id="backHome" style="border:0;background:transparent;color:inherit;padding:0;cursor:pointer">Início</button><span>›</span><strong>Produtos</strong></div>
      <div class="catalog-row">
        <div><h1>Produtos</h1><p>Encontre materiais para construção, ferramentas, hidráulica, elétrica, tintas e acabamento.</p></div>
        <div class="stats"><strong id="visibleCount">12</strong> produtos encontrados</div>
      </div>
    </div>
    <div class="toolbar-wrap">
      <div class="shell toolbar">
        <div class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Buscar cimento, torneira, furadeira..." autocomplete="off"></div>
        <button class="filter-toggle" id="filterToggle">Filtros</button>
        <select class="select" id="sortSelect">
          <option value="featured">Ordenar: Destaques</option><option value="price-asc">Menor preço</option><option value="price-desc">Maior preço</option><option value="name">Nome A–Z</option>
        </select>
      </div>
    </div>
    <div class="shell content">
      <aside class="sidebar" id="sidebar"><h3>Categorias</h3><div class="filters" id="filters"></div></aside>
      <div><div class="results-head"><span id="resultLabel">Todos os produtos</span><span>Preços de demonstração</span></div><div class="products" id="productsGrid"></div><div class="empty" id="emptyState">Nenhum produto encontrado.</div></div>
    </div>
  </section>
</main>

<div class="drawer-backdrop" id="drawerBackdrop"></div>
<aside class="drawer" id="cartDrawer">
  <div class="drawer-head"><h2>Seu carrinho</h2><button class="close" id="closeCart">×</button></div>
  <div class="cart-list" id="cartList"></div>
  <div class="drawer-foot"><div class="total"><span>Subtotal</span><strong id="cartTotal">R$ 0,00</strong></div><button class="checkout" id="checkoutBtn" disabled>Finalizar pelo WhatsApp</button></div>
</aside>
<button class="float-wa" id="floatWa" aria-label="WhatsApp">◉</button>

<script>
const PRODUCTS=[{"id": "cimento", "name": "Cimento CP II 50 kg", "category": "Materiais básicos", "price": 39.9, "old": 44.9, "icon": "🧱", "tag": "Mais vendido", "desc": "Cimento de uso geral para concretos, argamassas e aplicações na obra."}, {"id": "argamassa", "name": "Argamassa AC-II 20 kg", "category": "Materiais básicos", "price": 29.9, "old": 34.9, "icon": "🪣", "tag": "Oferta", "desc": "Indicada para assentamento de revestimentos em ambientes internos e externos."}, {"id": "furadeira", "name": "Furadeira de impacto 800 W", "category": "Ferramentas", "price": 269.9, "old": 319.9, "icon": "🛠️", "tag": "Destaque", "desc": "Furadeira de impacto para perfuração em alvenaria, madeira e metal."}, {"id": "chave13", "name": "Chave combinada 13 mm", "category": "Ferramentas", "price": 18.9, "old": null, "icon": "🔧", "tag": "", "desc": "Chave combinada resistente para manutenção e uso profissional."}, {"id": "ducha", "name": "Ducha elétrica 6800 W", "category": "Banheiro", "price": 89.9, "old": 99.9, "icon": "🚿", "tag": "Novidade", "desc": "Ducha elétrica com regulagem de temperatura e instalação prática."}, {"id": "tinta", "name": "Tinta acrílica premium 18 L", "category": "Tintas", "price": 179.9, "old": 209.9, "icon": "🎨", "tag": "Oferta", "desc": "Tinta acrílica para paredes internas e externas, acabamento fosco."}, {"id": "cabo", "name": "Cabo elétrico 2,5 mm² — 100 m", "category": "Elétrica", "price": 149.9, "old": null, "icon": "⚡", "tag": "", "desc": "Cabo flexível para instalações elétricas residenciais e comerciais."}, {"id": "torneira", "name": "Torneira de mesa cromada", "category": "Hidráulica", "price": 79.9, "old": 89.9, "icon": "🚰", "tag": "Oferta", "desc": "Torneira de mesa cromada para banheiro ou cozinha."}, {"id": "impermeabilizante", "name": "Impermeabilizante 18 kg", "category": "Impermeabilização", "price": 129.9, "old": 149.9, "icon": "🧴", "tag": "", "desc": "Proteção contra umidade para lajes, paredes e áreas molhadas."}, {"id": "parafusos", "name": "Kit parafusos e buchas", "category": "Ferragens", "price": 24.9, "old": null, "icon": "🔩", "tag": "", "desc": "Kit para fixações diversas em alvenaria, madeira e superfícies variadas."}, {"id": "lampada", "name": "Lâmpada LED 12 W", "category": "Elétrica", "price": 12.9, "old": 15.9, "icon": "💡", "tag": "Economia", "desc": "Lâmpada LED de baixo consumo para iluminação residencial."}, {"id": "porcelanato", "name": "Porcelanato 60 × 60 cm", "category": "Acabamento", "price": 59.9, "old": 69.9, "icon": "◻️", "tag": "", "desc": "Porcelanato para ambientes internos com acabamento moderno."}];
let activeCategory='Todos', searchTerm='', sortMode='featured';
let cart=loadCart();
const money=v=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(v);
const cats=['Todos',...new Set(PRODUCTS.map(p=>p.category))];

function showView(name, options={}){
  document.getElementById('homeView').classList.toggle('active',name==='home');
  document.getElementById('productsView').classList.toggle('active',name==='products');
  document.querySelectorAll('[data-nav]').forEach(b=>b.classList.toggle('active',name==='products' && b.dataset.nav==='produtos'));
  if(name==='products'){
    if(options.category){activeCategory=options.category;renderFilters();renderProducts();}
    window.scrollTo(0,0);
    if(options.focusSearch)setTimeout(()=>document.getElementById('searchInput').focus(),100);
  } else window.scrollTo(0,0);
  location.hash = name==='products' ? '#produtos' : '#inicio';
}
function loadCart(){try{return JSON.parse(localStorage.getItem('casa-amaral-cart')||'[]')}catch(e){return []}}
function saveCart(){localStorage.setItem('casa-amaral-cart',JSON.stringify(cart));renderCartCount()}
function renderCartCount(){document.getElementById('cartCount').textContent=cart.reduce((s,i)=>s+i.qty,0)}
function categoryCount(c){return c==='Todos'?PRODUCTS.length:PRODUCTS.filter(p=>p.category===c).length}
function renderFilters(){
  const box=document.getElementById('filters');
  box.innerHTML=cats.map(c=>`<button class="filter ${c===activeCategory?'active':''}" data-cat="${c}"><span>${c}</span><small>${categoryCount(c)}</small></button>`).join('');
  box.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{activeCategory=b.dataset.cat;renderFilters();renderProducts()});
}
function filteredProducts(){
  let data=PRODUCTS.filter(p=>activeCategory==='Todos'||p.category===activeCategory);
  if(searchTerm){const q=searchTerm.toLocaleLowerCase('pt-BR');data=data.filter(p=>(p.name+' '+p.category+' '+p.desc).toLocaleLowerCase('pt-BR').includes(q));}
  if(sortMode==='price-asc')data.sort((a,b)=>a.price-b.price);
  if(sortMode==='price-desc')data.sort((a,b)=>b.price-a.price);
  if(sortMode==='name')data.sort((a,b)=>a.name.localeCompare(b.name,'pt-BR'));
  return data;
}
function renderProducts(){
  const data=filteredProducts();
  document.getElementById('visibleCount').textContent=data.length;
  document.getElementById('resultLabel').textContent=activeCategory==='Todos'?'Todos os produtos':activeCategory;
  const grid=document.getElementById('productsGrid');
  grid.innerHTML=data.map(p=>`<article class="product">${p.tag?`<span class="tag">${p.tag}</span>`:''}<div class="media"><span class="emoji">${p.icon}</span></div><div class="cat">${p.category}</div><h3>${p.name}</h3><div class="desc">${p.desc}</div><div class="price-row"><div><span class="old">${p.old?money(p.old):'&nbsp;'}</span><span class="price">${money(p.price)}</span></div><button class="add" data-add="${p.id}">Adicionar</button></div></article>`).join('');
  document.getElementById('emptyState').style.display=data.length?'none':'block';
  grid.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>addToCart(b.dataset.add));
}
function addToCart(id){
  const p=PRODUCTS.find(x=>x.id===id), item=cart.find(x=>x.id===id);
  if(item)item.qty++; else cart.push({id:p.id,name:p.name,price:p.price,icon:p.icon,qty:1});
  saveCart();renderCart();
}
function changeQty(id,delta){const item=cart.find(x=>x.id===id);if(!item)return;item.qty+=delta;if(item.qty<=0)cart=cart.filter(x=>x.id!==id);saveCart();renderCart()}
function removeItem(id){cart=cart.filter(x=>x.id!==id);saveCart();renderCart()}
function renderCart(){
  const list=document.getElementById('cartList');
  if(!cart.length)list.innerHTML='<div class="cart-empty">Seu carrinho está vazio.<br><small>Adicione produtos para montar seu orçamento.</small></div>';
  else{
    list.innerHTML=cart.map(i=>`<div class="cart-item"><div class="cart-thumb">${i.icon}</div><div class="cart-info"><strong>${i.name}</strong><span>${money(i.price)} cada</span><div class="qty"><button data-minus="${i.id}">−</button><b>${i.qty}</b><button data-plus="${i.id}">+</button></div></div><button class="remove" data-remove="${i.id}">Remover</button></div>`).join('');
    list.querySelectorAll('[data-minus]').forEach(b=>b.onclick=()=>changeQty(b.dataset.minus,-1));
    list.querySelectorAll('[data-plus]').forEach(b=>b.onclick=()=>changeQty(b.dataset.plus,1));
    list.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>removeItem(b.dataset.remove));
  }
  document.getElementById('cartTotal').textContent=money(cart.reduce((s,i)=>s+i.price*i.qty,0));
  document.getElementById('checkoutBtn').disabled=!cart.length;renderCartCount();
}
function openCart(){document.getElementById('cartDrawer').classList.add('open');document.getElementById('drawerBackdrop').classList.add('open')}
function closeCart(){document.getElementById('cartDrawer').classList.remove('open');document.getElementById('drawerBackdrop').classList.remove('open')}
function checkoutWhatsApp(){
  if(!cart.length)return;
  const lines=cart.map(i=>`• ${i.qty}x ${i.name} — ${money(i.price*i.qty)}`);
  const total=money(cart.reduce((s,i)=>s+i.price*i.qty,0));
  const text=`Olá! Vim pelo site da Casa Amaral e gostaria de solicitar orçamento para:\n\n${lines.join('\n')}\n\nSubtotal estimado: ${total}`;
  window.open('https://wa.me/551436522025?text='+encodeURIComponent(text),'_blank');
}
function openGeneralWhatsApp(){window.open('https://wa.me/551436522025?text='+encodeURIComponent('Olá! Vim pelo site da Casa Amaral e gostaria de atendimento.'),'_blank')}

document.getElementById('brandBtn').onclick=()=>showView('home');
document.getElementById('mobileHome').onclick=()=>showView('home');
document.getElementById('heroProducts').onclick=()=>showView('products');
document.getElementById('heroCategories').onclick=()=>showView('products');
document.getElementById('backHome').onclick=()=>showView('home');
document.getElementById('searchBtn').onclick=()=>showView('products',{focusSearch:true});
document.getElementById('cartBtn').onclick=openCart;
document.getElementById('closeCart').onclick=closeCart;
document.getElementById('drawerBackdrop').onclick=closeCart;
document.getElementById('checkoutBtn').onclick=checkoutWhatsApp;
document.getElementById('homeWhatsApp').onclick=openGeneralWhatsApp;
document.getElementById('floatWa').onclick=openGeneralWhatsApp;
document.getElementById('filterToggle').onclick=()=>document.getElementById('sidebar').classList.toggle('open');
document.getElementById('searchInput').addEventListener('input',e=>{searchTerm=e.target.value.trim();renderProducts()});
document.getElementById('sortSelect').addEventListener('change',e=>{sortMode=e.target.value;renderProducts()});
document.getElementById('themeBtn').onclick=()=>{
  const next=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=next;localStorage.setItem('casa-amaral-theme',next);
  document.getElementById('themeBtn').textContent=next==='dark'?'☀':'☾';
};
document.getElementById('themeBtn').textContent=document.documentElement.dataset.theme==='dark'?'☀':'☾';
document.querySelectorAll('[data-nav]').forEach(btn=>btn.onclick=()=>{
  const n=btn.dataset.nav;
  if(n==='produtos')showView('products');
  else if(n==='categorias')showView('products');
  else if(n==='ferramentas')showView('products',{category:'Ferramentas'});
  else if(n==='contato')openGeneralWhatsApp();
});
renderFilters();renderProducts();renderCart();
if(location.hash==='#produtos')showView('products');
setTimeout(()=>document.getElementById('preloader').classList.add('hide'),900);
setTimeout(()=>document.getElementById('preloader')?.remove(),1450);
</script>
</body>
</html>
